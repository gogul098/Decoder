# One or more Groq keys, comma separated (keys from different Groq orgs add capacity)
GROQ_API_KEYS=gsk_your_key_here
# model:requests_per_minute:weight  — check your limits at console.groq.com/settings/limits
# GROQ_MODELS=openai/gpt-oss-120b:30:5,llama-3.3-70b-versatile:30:4,qwen/qwen3-32b:60:3,openai/gpt-oss-20b:30:3,meta-llama/llama-4-scout-17b-16e-instruct:30:2,llama-3.1-8b-instant:30:1
NEWS_REGION=IN
FEED_TTL_SECONDS=900
PREWARM=0
WORKER_CONCURRENCY=8
CLIENT_RPM=60
